# This is the ONLY env file the Compose stack reads (base file and server overlay alike).
# Copy it to deploy/.env.server on the customer machine, then run every compose command with
#
#   docker compose --env-file deploy/.env.server -f docker-compose.yml up -d --build
#
# Compose performs variable substitution inside env files, so a literal $ must be written
# as $$ here -- a bcrypt AUTH_PASSWORD_HASH such as $2b$12$abcd$31xy becomes
# $$2b$$12$$abcd$$31xy. An unescaped value is silently rewritten and login then fails with
# no error anywhere. Check before starting:
#
#   python scripts/check_deployment_env.py deploy/.env.server
#
# Do not reuse the repository root .env here: the app reads that file through
# python-dotenv, which keeps $$ literally and would then reject a correct password.

APP_ENV=production
CORS_ALLOW_ORIGINS=https://brain.example.internal
JWT_SECRET=
# The first three keys create the first administrator account when the user table is
# empty. AUTH_DEPARTMENT is optional but decisive: an account without a department can
# sign in and manage users, yet cannot own a dataset or an artifact, so it cannot upload
# data (403 department_scope_required) or produce a chart. A department cannot be added
# to an existing account later; recreating the account is the only supported change.
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_DEPARTMENT=
POSTGRES_DB=enterprise_brain
POSTGRES_USER=enterprise_brain
POSTGRES_PASSWORD=
POSTGRES_MAX_CONNECTIONS=200
REDIS_PASSWORD=
OLLAMA_BASE_URL=http://ollama:11434
LOCAL_MODEL_BASE_URL=http://ollama:11434/v1
LOCAL_MODEL_NAME=
LOCAL_MODEL_API_KEY=local
OLLAMA_IMAGE_TAG=latest

# --- embedding profile (R22, R90a) ------------------------------------------
# Which model produces the vectors, and how wide they are: one profile, not two knobs. R22
# binds every index version to model + width, and migration 0010 types the chunk column at
# exactly the width declared here.
#
# These two lines are what a first install needs to survive its own migrate step. 0010 refuses
# to guess a vector width, and scripts/migrate.py is the only thing that ever tells a database
# what this build embeds with (it issues the ALTER DATABASE ... SET pair itself, in
# app/db/migrations.py). Leave either line out and migrate stops naming the variable that is
# missing -- and because backend, worker and scheduler all wait for migrate to finish
# successfully, the whole stack stays down. That is deliberate: the shipped default is never
# substituted for a decision nobody made, and one database never holds two vector shapes.
#
# Changing EMBEDDING_MODEL means changing EMBEDDING_DIMENSION in the same edit whenever the new
# model answers a different number of dimensions, and then rebuilding the index by hand
# (python scripts/rebuild_index.py --status first, then --apply): vectors already stored cannot
# be relabelled, only rewritten. Restart backend, worker and scheduler after either line moves.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --- VECTOR_DUAL_WRITE: the pgvector mirror (R58, wired up by R120) ----------
# off is today's behaviour: app/rag/pg_store.py imports no psycopg, opens no connection and
# issues no SQL. on mirrors every vector Chroma accepts into chunk_vectors inside the same
# transaction, so either both engines hold a vector or neither does -- Chroma stays the read
# path either way, and only R59 changes that. This is a migration step, not a speed knob:
# turning it on belongs to docs/handoff/2026-09-17-pgvector-adoption-plan.md (P2/P3), and the
# first thing after switching it on is a full manual rebuild, because rows written before the
# switch exist only in Chroma. A value this file does not list is reported and treated as off.
VECTOR_DUAL_WRITE=off
# MODEL_THINKING: ask the local model to stop thinking before it answers, or not. On the
# OpenAI-compatible leg that is one request field, and it is measured rather than preferred:
# the same prompt at max_tokens=1536 answered 0 characters with finish_reason=length with
# thinking left alone and 93 characters with finish_reason=stop with
# "thinking": {"type": "disabled"} in the body (跟进单 §42, shipping container). That is the
# only spelling that works on this leg -- top-level "think": false and
# options.thinking_disabled are both measured at 0 characters, so neither is a way to ask for
# this. disabled is the default and sends the field; enabled sends no field at all, which is
# exactly the request this product sent before R100. Anything else -- empty, off, TRUE, a
# number -- resolves to disabled, warns once, and still sends the request. Every
# [ModelBudget] line carries thinking= so a log says which mode produced it.
MODEL_THINKING=disabled
MODEL_MAX_CONCURRENCY=1
MODEL_REQUEST_TIMEOUT=120

# --- per-tier output caps and clocks (R30) --------------------------------
# MODEL_REQUEST_TIMEOUT is the ceiling for one request; the clock a request actually
# gets is derived from its own prompt and its tier's cap:
#   read = margin * (prompt_tokens/MODEL_PREFILL_TOKENS_PER_SECOND
#                    + max_tokens/MODEL_DECODE_TOKENS_PER_SECOND), floored and capped.
# These numbers are the code defaults, so deleting a line changes nothing. See the
# matching block in the repository root .env.example for what each one means.
# A tier cap is what the tier asks to write, not a promise the clock can pay for: when
# the two contradict each other the answer is shortened to fit, never below
# MODEL_MIN_ANSWER_TOKENS, and never by shortening the deadline instead.
MODEL_TIER_CHAT_MAX_TOKENS=256
MODEL_TIER_PLAN_MAX_TOKENS=256
MODEL_TIER_REWRITE_MAX_TOKENS=256
MODEL_TIER_ALERT_MAX_TOKENS=384
MODEL_TIER_COMPRESS_MAX_TOKENS=512
MODEL_TIER_CODE_MAX_TOKENS=512
MODEL_TIER_ANALYSIS_MAX_TOKENS=1536
# MODEL_PREFILL/DECODE_TOKENS_PER_SECOND are CALIBRATED MEASUREMENTS, not preferences:
# they are the CPU-only floor measured on the delivery baseline on 2026-09-16, and the
# only command that produces them is scripts/bench_model_throughput.py. Re-measure on the
# hardware you ship and write what it prints. MODEL_MIN_ANSWER_TOKENS is measured the same
# way, and R100 re-measured it for the link that ships now: 1537 was the floor of a THINKING
# model (0 visible characters at 1024 and 1536 output tokens, 439 characters at 4096), while
# 1536 is the smallest cap with a recorded non-empty answer once MODEL_THINKING=disabled is
# on the wire. It is the cap an answer is never shortened below; a tier that cannot fit above
# it is reported as budget_unaffordable instead of answered with nothing. Lower than 1536 is
# 待真机标定: scripts/bench_model_throughput.py has to learn the compat-leg spelling of the
# thinking switch before it can bracket that, because as landed it re-measures thinking-on.
MODEL_PREFILL_TOKENS_PER_SECOND=35
MODEL_DECODE_TOKENS_PER_SECOND=8
MODEL_MIN_ANSWER_TOKENS=1536
MODEL_TIMEOUT_MARGIN=1.15
MODEL_TIMEOUT_FLOOR_SECONDS=10
MODEL_CONNECT_TIMEOUT_SECONDS=5
# n_ctx of the local server: a prompt that cannot fit this window plus its tier's cap
# is refused with error_code=context_limit_exceeded instead of answered half-truncated.
MODEL_CONTEXT_TOKENS=4096

# --- row-level department scope (R17) -------------------------------------
# fail_closed (default): a row whose department cannot be resolved stays invisible.
# legacy: the pre-R17 widening, and the only way to ask for it is to write it here.
RBAC_ROW_DEPARTMENT_SCOPE=fail_closed
# --- document activity prior (R46, shipped by R152; recalibration open as R153) ---
# Every answer that retrieves can nudge the order of its own candidates using a per-document count of
# 「this source was used / this source was wrong」, written through POST /api/v1/feedback/document.
# Storage is counts only: migrations/0011 has no text column, and the request body is refused (422) if
# it carries anything beyond filename and signal, so a user question cannot land in that table.
# on is the default, and that is also what an install that sets nothing gets. Rollback is an explicit
# off; 0 / false / no work too, while a value this file does not list is read as on, never as off -
# treating 「nobody configured it」 as 「configured off」 would retire the feature by typo.
# If the table is missing or PostgreSQL is unreachable the ranker keeps the order it had before R46
# (fail-open, and the reason is not lost: GET /api/v1/feedback/document reports prior_source and
# prior_reason, which is how 「no signal」 and 「no read」 stay distinguishable).
# Read the size of the nudge before trusting it. Since R153 the prior is stated in ranks, not in score:
# one net acceptance is worth half a rank and the hard bound is ACTIVITY_PRIOR_MAX_SHIFT_RANKS = 1,
# measured identical at leg widths 5, 12 and 40. Before that calibration one click could lift a hit from
# 5th to 1st in the k=5 leg this app ships. It can still swap the top two of a short leg, and there is no
# per-person throttle or cooldown (owner decision), so this switch stays an experiment, not a quality
# guarantee - off is still the conservative setting.
# The app reads this when the container is created, so changing it takes a recreate, not a reload.
RAG_ACTIVITY_PRIOR=on


HTTP_PORT=80
APP_TIMEZONE=Asia/Shanghai
APP_DEFAULT_CURRENCY=CNY
LANGSMITH_TRACING=false
# ---------------------------------------------------------------------------
# Build-time only: read by `docker compose build`, never by the running app.
# Leave empty to install Debian packages from the upstream archive. Point it at a
# mirror that the build machine can actually reach (host name only, no scheme) when
# the link drops long downloads, for example mirrors.tuna.tsinghua.edu.cn.
APT_MIRROR=
